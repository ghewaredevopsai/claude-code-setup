{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && uv run -q python scripts/validate_agent.py",
            "timeout": 90
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && echo 'Latest experiments:' && tail -n 5 EXPERIMENTS.md && scripts/exp.sh session status 2>/dev/null | head -1"
          }
        ]
      }
    ]
  }
}
